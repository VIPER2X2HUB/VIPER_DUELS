-- حلقة تشغيل ألوان الـ RGB والنيون بشكل مستمر
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    if not ScreenGui.Parent then return end
    hue = (hue + dt * 0.25) % 1
    
    local rgbColor = Color3.fromHSV(hue, 0.95, 1)
    local neonAccent = Color3.fromHSV((hue + 0.15) % 1, 0.85, 1)
    
    -- تطبيق الألوان على العناصر
    RGBStroke.Color = rgbColor
    NeonGlow.ImageColor3 = rgbColor
    Divider.BackgroundColor3 = rgbColor
    BtnStroke.Color = neonAccent
    TitleStroke.Color = rgbColor
    MsgStroke.Color = neonAccent
    TitleLabel.TextColor3 = Color3.fromHSV(hue, 0.35, 1)
end)
